@model WasteConnect.ViewModels.CouncillorDashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Councillor Dashboard";

    var totalReports = Model.Reports.Count;

    var pendingReports = Model.Reports.Count(report =>
        string.Equals(
            report.Status,
            "Pending",
            StringComparison.OrdinalIgnoreCase));

    var assignedReports = Model.Reports.Count(report =>
        string.Equals(
            report.Status,
            "Assigned",
            StringComparison.OrdinalIgnoreCase));

    var inProgressReports = Model.Reports.Count(report =>
        string.Equals(
            report.Status,
            "In Progress",
            StringComparison.OrdinalIgnoreCase)
        ||
        string.Equals(
            report.Status,
            "InProgress",
            StringComparison.OrdinalIgnoreCase));

    var completedReports = Model.Reports.Count(report =>
        string.Equals(
            report.Status,
            "Cleaned",
            StringComparison.OrdinalIgnoreCase)
        ||
        string.Equals(
            report.Status,
            "Completed",
            StringComparison.OrdinalIgnoreCase));

    var highPriorityReports = Model.Reports.Count(report =>
        string.Equals(
            report.Priority,
            "High",
            StringComparison.OrdinalIgnoreCase));

    var totalResidentsReporting = Model.Reports.Sum(report =>
        report.DuplicateCount > 0
            ? report.DuplicateCount
            : 1);
}

<link rel="stylesheet"
      href="~/css/councillor.css"
      asp-append-version="true" />

<div class="councillor-page">

    <section class="councillor-hero">

        <div class="hero-content">

            <span class="hero-label">
                WasteConnect Councillor Portal
            </span>

            <h1>
                Welcome, @Model.CouncillorName
            </h1>

            <p>
                Monitor illegal-dumping reports, community concerns,
                cleanup progress and service-delivery activity in your ward.
            </p>

        </div>

        <div class="hero-ward-card">

            <span>
                Assigned Ward
            </span>

            <strong>
                @(Model.WardNumber > 0
                                ? $"Ward {Model.WardNumber}"
                                : "Not Assigned")
            </strong>

            <small>
                Official municipal ward
            </small>

        </div>

    </section>

    @if (TempData["Error"] != null)
    {
        <div class="dashboard-alert dashboard-alert-error">
            @TempData["Error"]
        </div>
    }

    <section class="dashboard-stat-grid">

        <article class="dashboard-stat-card">

            <div class="stat-icon">
                📋
            </div>

            <div class="stat-content">

                <span>
                    Total Reports
                </span>

                <strong>
                    @totalReports
                </strong>

                <small>
                    All reports in Ward @Model.WardNumber
                </small>

            </div>

        </article>

        <article class="dashboard-stat-card">

            <div class="stat-icon">
                ⏳
            </div>

            <div class="stat-content">

                <span>
                    Pending
                </span>

                <strong>
                    @pendingReports
                </strong>

                <small>
                    Awaiting municipal action
                </small>

            </div>

        </article>

        <article class="dashboard-stat-card">

            <div class="stat-icon">
                🚛
            </div>

            <div class="stat-content">

                <span>
                    Active Cleanups
                </span>

                <strong>
                    @(assignedReports + inProgressReports)
                </strong>

                <small>
                    Assigned or in progress
                </small>

            </div>

        </article>

        <article class="dashboard-stat-card">

            <div class="stat-icon">
                ✓
            </div>

            <div class="stat-content">

                <span>
                    Completed
                </span>

                <strong>
                    @completedReports
                </strong>

                <small>
                    Cleaned dumping sites
                </small>

            </div>

        </article>

        <article class="dashboard-stat-card">

            <div class="stat-icon">
                ⚠️
            </div>

            <div class="stat-content">

                <span>
                    High Priority
                </span>

                <strong>
                    @highPriorityReports
                </strong>

                <small>
                    Areas needing urgent attention
                </small>

            </div>

        </article>

        <article class="dashboard-stat-card">

            <div class="stat-icon">
                👥
            </div>

            <div class="stat-content">

                <span>
                    Residents Reporting
                </span>

                <strong>
                    @totalResidentsReporting
                </strong>

                <small>
                    Community reports received
                </small>

            </div>

        </article>

    </section>

    <section class="dashboard-main-grid">

        <div class="ward-reports-card">

            <div class="section-heading">

                <div>

                    <span class="section-label">
                        Ward Monitoring
                    </span>

                    <h2>
                        Ward Reports
                    </h2>

                    <p>
                        Reports identified as belonging to Ward
                        @Model.WardNumber appear automatically below.
                    </p>

                </div>

                <div class="report-filter-group">

                    <button type="button"
                            class="report-filter active"
                            data-filter="all">
                        All
                    </button>

                    <button type="button"
                            class="report-filter"
                            data-filter="pending">
                        Pending
                    </button>

                    <button type="button"
                            class="report-filter"
                            data-filter="assigned">
                        Assigned
                    </button>

                    <button type="button"
                            class="report-filter"
                            data-filter="in-progress">
                        In Progress
                    </button>

                    <button type="button"
                            class="report-filter"
                            data-filter="cleaned">
                        Cleaned
                    </button>

                    <button type="button"
                            class="report-filter"
                            data-filter="high">
                        High Priority
                    </button>

                </div>

            </div>

            @if (Model.WardNumber <= 0)
            {
                <div class="dashboard-empty-state">

                    <div class="empty-state-icon">
                        ⚠️
                    </div>

                    <h3>
                        No ward assigned
                    </h3>

                    <p>
                        Your account has not yet been linked to a municipal
                        ward. Please contact the WasteConnect administrator.
                    </p>

                </div>
            }
            else if (!Model.Reports.Any())
            {
                <div class="dashboard-empty-state">

                    <div class="empty-state-icon">
                        📍
                    </div>

                    <h3>
                        No reports in Ward @Model.WardNumber
                    </h3>

                    <p>
                        New illegal-dumping reports identified in your ward
                        will automatically appear here.
                    </p>

                </div>
            }
            else
            {
                <div class="reports-table-container">

                    <table class="reports-table">

                        <thead>
                            <tr>
                                <th>Area</th>
                                <th>Priority</th>
                                <th>Residents Reporting</th>
                                <th>Status</th>
                                <th>Reported</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="wardReportsTable">

                            @foreach (var report in Model.Reports)
                            {
                                var statusValue =
                                (report.Status ?? "Pending")
                                .Trim()
                                .ToLowerInvariant()
                                .Replace(" ", "-");

                                var priorityValue =
                                (report.Priority ?? "Low")
                                .Trim()
                                .ToLowerInvariant();

                                <tr class="ward-report-row"
                                    data-status="@statusValue"
                                    data-priority="@priorityValue">

                                    <td>

                                        <div class="report-area-cell">

                                            <strong>
                                                @report.DumpingLocation
                                            </strong>

                                            <span>
                                                Ward @report.WardNumber
                                            </span>

                                        </div>

                                    </td>

                                    <td>

                                        <span class="priority-badge @priorityValue">
                                            @(string.IsNullOrWhiteSpace(report.Priority)
                                                                                ? "Low"
                                                                                : report.Priority)
                                                                                              </span>

                                    </td>

                                    <td>

                                        <span class="resident-report-count">
                                            @(report.DuplicateCount > 0
                                                                                ? report.DuplicateCount
                                                                                : 1)
                                                                                </span>

                                    </td>

                                    <td>

                                        <span class="status-badge @statusValue">
                                            @(string.IsNullOrWhiteSpace(report.Status)
                                                                                ? "Pending"
                                                                                : report.Status)
                                </span>

                                    </td>

                                    <td>

                                        <div class="report-date-cell">

                                            <strong>
                                                @report.CreatedAt
                                                .ToLocalTime()
                                                .ToString("dd MMM yyyy")
                                            </strong>

                                            <span>
                                                @report.CreatedAt
                                                .ToLocalTime()
                                                .ToString("HH:mm")
                                            </span>

                                        </div>

                                    </td>

                                    <td>

                                        <a asp-controller="Councillor"
                                           asp-action="ReportDetails"
                                           asp-route-id="@report.Id"
                                           asp-route-userId="@report.UserId"
                                           class="view-report-button">
                                            View Report
                                        </a>

                                    </td>

                                </tr>
                                                }

                        </tbody>

                    </table>

                    <div id="filteredEmptyState"
                         class="filtered-empty-state">

                        No reports match the selected filter.

                    </div>

                </div>
            }

        </div>

        <aside class="councillor-profile-card">

            <div class="profile-card-header">

                <div class="profile-avatar">
                    @(
                                        string.IsNullOrWhiteSpace(Model.CouncillorName)
                                        ? "C"
                                        : Model.CouncillorName.Substring(0, 1).ToUpper()
                                        )
                </div>

                <div>

                    <span>
                        Councillor Profile
                    </span>

                    <h3>
                        @Model.CouncillorName
                    </h3>

                </div>

            </div>

            <div class="profile-detail-list">

                <div class="profile-detail-row">

                    <span>
                        Email
                    </span>

                    <strong>
                        @Model.Email
                    </strong>

                </div>

                <div class="profile-detail-row">

                    <span>
                        Position
                    </span>

                    <strong>
                        @Model.PositionTitle
                    </strong>

                </div>

                <div class="profile-detail-row">

                    <span>
                        Assigned Ward
                    </span>

                    <strong>
                        @(Model.WardNumber > 0
                                                ? $"Ward {Model.WardNumber}"
                                                : "Not Assigned")
                    </strong>

                </div>

                <div class="profile-detail-row">

                    <span>
                        Portal Access
                    </span>

                    <strong class="read-only-label">
                        Read-only monitoring
                    </strong>

                </div>

            </div>

            <div class="account-active-message">

                <span class="active-status-dot"></span>

                Account active

            </div>

            <div class="profile-permissions">

                <h4>
                    Your permissions
                </h4>

                <div class="permission-item allowed">
                    <span>✓</span>
                    View ward reports
                </div>

                <div class="permission-item allowed">
                    <span>✓</span>
                    Monitor cleanup status
                </div>

                <div class="permission-item allowed">
                    <span>✓</span>
                    View priorities and photos
                </div>

                <div class="permission-item restricted">
                    <span>×</span>
                    Cannot change report status
                </div>

                <div class="permission-item restricted">
                    <span>×</span>
                    Cannot assign companies
                </div>

            </div>

        </aside>

    </section>

</div>

<script src="~/js/councillor.js"
        asp-append-version="true"></script>