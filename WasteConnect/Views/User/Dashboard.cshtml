
@model WasteConnect.ViewModels.CommunityAlertsViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "User Dashboard";
}

<section class="community-alerts-section">

    <!-- HEADER -->
    <div class="community-alerts-header">

        <div>
            <h2>Community Alerts</h2>

            <p>
                Stay informed about municipal service interruptions
                and collection updates.
            </p>
        </div>

    </div>


    <!-- THREE ALERT BOXES -->
    <div class="community-alert-boxes">

        <!-- ELECTRICITY -->
        <button type="button"
                class="community-alert-box electricity-box"
                data-alert-target="electricity-alert-modal">

            <div class="alert-box-icon">
                ⚡
            </div>

            <div class="alert-box-content">

                <span class="alert-box-label">
                    Community Alert
                </span>

                <h3>
                    Electricity
                </h3>

            </div>

            <div class="alert-count @(Model.ElectricityAlerts.Count > 0 ? "has-alerts" : "")">
                @Model.ElectricityAlerts.Count
            </div>

        </button>


        <!-- WATER -->
        <button type="button"
                class="community-alert-box water-box"
                data-alert-target="water-alert-modal">

            <div class="alert-box-icon">
                💧
            </div>

            <div class="alert-box-content">

                <span class="alert-box-label">
                    Community Alert
                </span>

                <h3>
                    Water
                </h3>

            </div>

            <div class="alert-count @(Model.WaterAlerts.Count > 0 ? "has-alerts" : "")">
                @Model.WaterAlerts.Count
            </div>

        </button>


        <!-- BIN COLLECTION -->
        <button type="button"
                class="community-alert-box bin-box"
                data-alert-target="bin-alert-modal">

            <div class="alert-box-icon">
                🗑️
            </div>

            <div class="alert-box-content">

                <span class="alert-box-label">
                    Community Alert
                </span>

                <h3>
                    Bin Collection
                </h3>

            </div>

            <div class="alert-count @(Model.BinCollectionAlerts.Count > 0 ? "has-alerts" : "")">
                @Model.BinCollectionAlerts.Count
            </div>

        </button>

    </div>


    <!-- ===================================================== -->
    <!-- ELECTRICITY MODAL -->
    <!-- ===================================================== -->

    <div id="electricity-alert-modal"
         class="community-alert-modal">

        <div class="community-alert-modal-content">

            <button type="button"
                    class="close-alert-modal"
                    aria-label="Close">
                &times;
            </button>

            <div class="modal-header">

                <div class="modal-icon">
                    ⚡
                </div>

                <div>
                    <span class="modal-small-label">
                        Community Alert
                    </span>

                    <h2>
                        Electricity
                    </h2>
                </div>

            </div>


            @if (Model.ElectricityAlerts.Any())
            {
                foreach (var alert in Model.ElectricityAlerts)
                {
                    <div class="modal-alert-item">

                        <div class="modal-alert-status">
                            @alert.Status
                        </div>


                        <div class="modal-information">

                            <span class="modal-label">
                                Location
                            </span>

                            <p>
                                @if (alert.AreaType == "Ward")
                                {
                                    @:Ward @alert.WardNumber
                                }
                                else if (alert.AreaType == "Area")
                                {
                                    @alert.SpecificArea
                                }
                                else
                                {
                                    @:Entire Municipality
                                }
                            </p>

                        </div>


                        <div class="modal-information">

                            <span class="modal-label">
                                Reason
                            </span>

                            <p>
                                @alert.Reason
                            </p>

                        </div>


                        <div class="modal-date-grid">

                            <div class="modal-information">

                                <span class="modal-label">
                                    Starts
                                </span>

                                <p>
                                    @alert.StartDateTime.ToString("dd MMM yyyy, HH:mm")
                                </p>

                            </div>


                            @if (alert.EndDateTime.HasValue)
                            {
                                <div class="modal-information">

                                    <span class="modal-label">
                                        Expected End
                                    </span>

                                    <p>
                                        @alert.EndDateTime.Value.ToString("dd MMM yyyy, HH:mm")
                                    </p>

                                </div>
                            }

                        </div>


                        <div class="modal-information">

                            <span class="modal-label">
                                Priority
                            </span>

                            <p>
                                @alert.Priority
                            </p>

                        </div>


                        @if (!string.IsNullOrWhiteSpace(alert.Description))
                        {
                            <div class="modal-description">

                                <span class="modal-label">
                                    Additional Information
                                </span>

                                <p>
                                    @alert.Description
                                </p>

                            </div>
                        }

                    </div>
                }
            }
            else
            {
                <div class="modal-empty-state">
                    <div>✓</div>

                    <h3>
                        No Electricity Alerts
                    </h3>

                    <p>
                        There are currently no electricity alerts.
                    </p>
                </div>
            }


            <button type="button"
                    class="modal-close-button close-alert-modal">
                Close
            </button>

        </div>

    </div>



